<mxfile host="app.diagrams.net" type="device">
  <diagram id="dfd-products" name="DFD Thực đơn và Sản phẩm">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Chức năng phân hệ quản lý thực đơn và sản phẩm" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="150" y="30" width="550" height="30" as="geometry" />
        </mxCell>

        <!-- Tác nhân ngoài -->
        <mxCell id="manager" value="Quản lý quán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Tiến trình (Hình tròn) -->
        <mxCell id="p21" value="2.1. Quản lý&lt;br&gt;danh mục món" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="105" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p22" value="2.2. Thêm &amp; sửa&lt;br&gt;món đồ uống" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="105" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p23" value="2.3. Tải lên &amp;&lt;br&gt;lưu trữ ảnh món" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="340" y="420" width="105" height="105" as="geometry" />
        </mxCell>

        <!-- Kho dữ liệu (2 đường song song) -->
        <mxCell id="d_cat" value="Danh mục sản phẩm" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="590" y="140" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d_prod" value="Thực đơn món" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="590" y="290" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d_img" value="Thư mục hình ảnh" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="590" y="450" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="Thêm / Sửa danh mục" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="manager" target="p21">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="163" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Lưu danh mục" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="p21" target="d_cat"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e3" value="Tên món, giá, danh mục" style="edgeStyle=straight;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="manager" target="p22"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Đọc danh mục hợp lệ" style="edgeStyle=straight;rounded=0;html=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="d_cat" target="p22"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Lưu bản ghi món" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="p22" target="d_prod"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" value="Tải tệp ảnh món" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="manager" target="p23">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="473" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="Lưu trữ tệp vật lý" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="p23" target="d_img"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Trả URL ảnh" style="edgeStyle=straight;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;fontColor=#000000;" edge="1" parent="1" source="p23" target="p22"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
