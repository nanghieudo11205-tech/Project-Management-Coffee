<mxfile host="app.diagrams.net" type="device">
  <diagram id="seq-checkout" name="Sequence Thanh toán hóa đơn">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BIỂU ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM): THANH TOÁN HÓA ĐƠN (CHECKOUT)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="750" height="30" as="geometry" />
        </mxCell>

        <!-- LIFELINES -->
        <mxCell id="act_cashier" value="Thu ngân" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="100" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_ui" value="Giao diện POS" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_ctrl" value="OrderController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_svc" value="OrderService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="610" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_order_repo" value="OrderRepo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="790" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_table_repo" value="CafeTableRepo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="970" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <!-- MESSAGES -->
        <mxCell id="m1" value="1. Chọn đơn -> Chọn CASH/BANKING -> Bấm &quot;Thanh toán&quot;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="160" as="sourcePoint" /><mxPoint x="310" y="160" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. POST /api/orders/{id}/checkout?paymentMethod=CASH" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="200" as="sourcePoint" /><mxPoint x="490" y="200" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. checkout(orderId, paymentMethod)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="240" as="sourcePoint" /><mxPoint x="670" y="240" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. findById(orderId)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="280" as="sourcePoint" /><mxPoint x="850" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. Order (status: PENDING)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="850" y="320" as="sourcePoint" /><mxPoint x="670" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6. order.setStatus(&quot;PAID&quot;) &amp; save(order)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="360" as="sourcePoint" /><mxPoint x="850" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7. table.setStatus(&quot;AVAILABLE&quot;) &amp; save(table)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="400" as="sourcePoint" /><mxPoint x="1030" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m8" value="8. Bàn được giải phóng (Trống)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1030" y="440" as="sourcePoint" /><mxPoint x="670" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m9" value="9. Trả về Order đã thanh toán" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="670" y="480" as="sourcePoint" /><mxPoint x="490" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m10" value="10. HTTP 200 OK" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="490" y="520" as="sourcePoint" /><mxPoint x="310" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m11" value="11. Mở modal in hóa đơn &amp; Toast &quot;Thanh toán thành công&quot;" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="310" y="560" as="sourcePoint" /><mxPoint x="130" y="560" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
