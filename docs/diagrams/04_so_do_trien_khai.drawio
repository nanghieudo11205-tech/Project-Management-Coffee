        <mxCell id="e_a_db" value="JDBC / TCP :1433" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#B25900;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="node_app" target="node_db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_w_cloud" value="HTTPS API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="node_web" target="node_cloud"><mxGeometry relative="1" as="geometry" /></mxCell>

