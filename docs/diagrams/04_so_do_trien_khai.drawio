        </mxCell>

        <mxCell id="art_browser" value="«executionEnvironment»&#xa;&lt;b&gt;Web Browser&lt;/b&gt;&#xa;(Chrome / Edge)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="150" width="210" height="80" as="geometry" />
        </mxCell>

        <mxCell id="art_storage" value="«artifact»&#xa;LocalStorage&#xa;(Lưu trữ AccessToken JWT)" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="85" y="260" width="210" height="70" as="geometry" />
