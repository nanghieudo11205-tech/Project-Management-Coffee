        <!-- NODE 2: WEB SERVER -->
        <mxCell id="node_web" value="«device / cloud»&#xa;&lt;b&gt;Frontend Server (Vercel / Node.js)&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;shape=cube;size=10;direction=south;fontStyle=0;fontSize=13;" vertex="1" parent="1">
