<mxfile host="app.diagrams.net" type="device">
  <diagram id="deployment-diagram" name="Sơ đồ triển khai">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BIỂU ĐỒ TRIỂN KHAI HỆ THỐNG (DEPLOYMENT DIAGRAM)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="650" height="30" as="geometry" />
        </mxCell>

        <!-- NODE 1: CLIENT -->
        <mxCell id="node_client" value="«device»&#xa;&lt;b&gt;Client Device (PC / POS / Tablet)&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=10;html=1;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;shape=cube;size=10;direction=south;fontStyle=0;fontSize=13;" vertex="1" parent="1">
