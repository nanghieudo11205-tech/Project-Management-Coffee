        <mxCell id="art_nextjs" value="«executionEnvironment»&#xa;&lt;b&gt;Node.js Runtime v20+&lt;/b&gt;&#xa;- Next.js 15 SSR Engine&#xa;- API Proxy: /api/chat" style="shape=rect;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="220" height="110" as="geometry" />
