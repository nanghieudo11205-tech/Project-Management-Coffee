        <mxCell id="e_c_w" value="HTTPS :443" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=1.5;fontSize=12;" edge="1" parent="1" source="node_client" target="node_web"><mxGeometry relative="1" as="geometry" /></mxCell>
