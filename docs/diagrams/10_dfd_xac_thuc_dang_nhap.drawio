<mxfile host="app.diagrams.net" type="device">
  <diagram id="dfd-auth" name="DFD Xác thực và Đăng nhập">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Chức năng phân hệ xác thực và phân quyền (Authentication)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="150" y="30" width="600" height="30" as="geometry" />
        </mxCell>

        <!-- Tác nhân ngoài -->
        <mxCell id="user" value="Người dùng&#xa;(Staff / Admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="190" width="120" height="50" as="geometry" />
        </mxCell>

        <mxCell id="google" value="Google OAuth2&#xa;Service" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Tiến trình (Hình tròn) -->
        <mxCell id="p11" value="1.1. Tiếp nhận&#xa;đăng nhập" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="105" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p12" value="1.2. Xác thực &amp;&#xa;cấp mã JWT" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="105" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p13" value="1.3. Xác thực&#xa;Google OAuth" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="420" width="105" height="105" as="geometry" />
        </mxCell>

        <!-- Kho dữ liệu (2 đường song song) -->
        <mxCell id="d_acc" value="Tài khoản hệ thống" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="600" y="290" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="Username &amp; Password" style="edgeStyle=straight;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="user" target="p11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="Chuyển dữ liệu" style="edgeStyle=straight;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry" /></mxCell>
        
        <mxCell id="e3" value="Truy vấn Account &amp; hash" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p12" target="d_acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Kiểm tra BCrypt" style="edgeStyle=straight;rounded=0;html=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="d_acc" target="p12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Trả Token JWT &amp; Role" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p12" target="user">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="313" /><mxPoint x="250" y="270" /><mxPoint x="110" y="270" /></Array></mxGeometry>
        </mxCell>

        <mxCell id="e6" value="Đăng nhập Google" style="edgeStyle=straight;rounded=0;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="user" target="google"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Google ID Token" style="edgeStyle=straight;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="google" target="p13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Xác thực &amp; liên kết" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p13" target="d_acc">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="675" y="473" /></Array></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
