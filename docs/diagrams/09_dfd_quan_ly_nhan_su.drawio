<mxfile host="app.diagrams.net" type="device">
  <diagram id="dfd-employees" name="DFD Quản lý Nhân sự">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Chức năng phân hệ quản lý nhân sự" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="150" y="30" width="500" height="30" as="geometry" />
        </mxCell>

        <!-- Tác nhân ngoài -->
        <mxCell id="manager" value="Ban quản lý&#xa;(Admin)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="270" width="120" height="50" as="geometry" />
        </mxCell>

        <!-- Tiến trình (Hình tròn) -->
        <mxCell id="p61" value="6.1. Quản lý&#xa;hồ sơ nhân sự" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="110" width="105" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p62" value="6.2. Cấp &amp; phân&#xa;quyền tài khoản" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="260" width="105" height="105" as="geometry" />
        </mxCell>

        <mxCell id="p63" value="6.3. Khóa / mở&#xa;khóa tài khoản" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="340" y="420" width="105" height="105" as="geometry" />
        </mxCell>

        <!-- Kho dữ liệu (2 đường song song) -->
        <mxCell id="d_emp" value="Hồ sơ nhân viên" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590" y="160" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="d_acc" value="Tài khoản hệ thống" style="shape=partialRectangle;top=1;bottom=1;left=0;right=0;fillColor=none;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=middle;whiteSpace=wrap;html=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="590" y="340" width="150" height="40" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" value="Họ tên, SĐT, CCCD, lương" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="manager" target="p61">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="163" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e2" value="Lưu hồ sơ" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p61" target="d_emp"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e3" value="Username, password, role" style="edgeStyle=straight;rounded=0;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="manager" target="p62"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Lưu Account BCrypt" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p62" target="d_acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="Gán account_id" style="edgeStyle=straight;rounded=0;html=1;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p62" target="d_emp"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="e6" value="Khóa / Kích hoạt tài khoản" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="manager" target="p63">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="110" y="473" /></Array></mxGeometry>
        </mxCell>
        <mxCell id="e7" value="Cập nhật isActive" style="edgeStyle=straight;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1" source="p63" target="d_acc"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
