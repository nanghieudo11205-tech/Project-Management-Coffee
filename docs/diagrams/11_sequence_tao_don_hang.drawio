<mxfile host="app.diagrams.net" type="device">
  <diagram id="seq-create-order" name="Sequence Tạo đơn hàng">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="BIỂU ĐỒ TUẦN TỰ (SEQUENCE DIAGRAM): TẠO ĐƠN HÀNG TẠI BÀN (POS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="750" height="30" as="geometry" />
        </mxCell>

        <!-- LIFELINES (CÁC ĐỐI TƯỢNG) -->
        <mxCell id="act_staff" value="Thu ngân" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="100" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_ui" value="Giao diện POS&#xa;(/orders)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_ctrl" value="OrderController" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_svc" value="OrderService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_table_repo" value="CafeTableRepo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <mxCell id="ll_order_repo" value="OrderRepo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="120" height="600" as="geometry" />
        </mxCell>

        <!-- MESSAGES -->
        <mxCell id="m1" value="1. Chọn bàn, chọn món &amp; bấm &quot;Tạo đơn&quot;" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="130" y="160" as="sourcePoint" /><mxPoint x="300" y="160" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m2" value="2. POST /api/orders {tableId, details}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="200" as="sourcePoint" /><mxPoint x="480" y="200" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m3" value="3. createOrder(request)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="480" y="240" as="sourcePoint" /><mxPoint x="660" y="240" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m4" value="4. findById(tableId) &amp; setStatus(&quot;OCCUPIED&quot;)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="280" as="sourcePoint" /><mxPoint x="840" y="280" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m5" value="5. Bàn đã chuyển sang OCCUPIED" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="840" y="320" as="sourcePoint" /><mxPoint x="660" y="320" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m6" value="6. save(Order PENDING, details, totalAmount)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="360" as="sourcePoint" /><mxPoint x="1020" y="360" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m7" value="7. Order đã lưu CSDL" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="1020" y="400" as="sourcePoint" /><mxPoint x="660" y="400" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m8" value="8. Trả về Order Entity" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="660" y="440" as="sourcePoint" /><mxPoint x="480" y="440" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m9" value="9. HTTP 201 Created (Order Response)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="480" y="480" as="sourcePoint" /><mxPoint x="300" y="480" as="targetPoint" /></mxGeometry>
        </mxCell>

        <mxCell id="m10" value="10. Toast &quot;Tạo đơn thành công&quot;, Bàn đổi màu đỏ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#000000;strokeWidth=1.2;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="520" as="sourcePoint" /><mxPoint x="130" y="520" as="targetPoint" /></mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
