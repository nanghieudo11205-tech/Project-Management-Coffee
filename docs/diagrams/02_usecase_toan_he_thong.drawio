        <mxCell id="l_s_order" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" edge="1" parent="1" source="act_staff" target="uc_order"><mxGeometry relative="1" as="geometry" /></mxCell>
