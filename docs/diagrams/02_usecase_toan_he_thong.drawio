<mxfile host="app.diagrams.net" type="device">
  <diagram id="usecase-system" name="Use Case Toàn hệ thống">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SƠ ĐỒ USE CASE TOÀN HỆ THỐNG QUẢN LÝ QUÁN CÀ PHÊ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="650" height="30" as="geometry" />
        </mxCell>

        <!-- Boundary hệ thống -->
        <mxCell id="sys_box" value="Hệ thống Website Quản lý Quán Cà Phê (Web QLCafe)" style="shape=rect;html=1;verticalAlign=top;fontStyle=1;whiteSpace=wrap;align=center;fillColor=none;strokeColor=#000000;strokeWidth=1.5;fontSize=14;fontFamily=Helvetica;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="220" y="80" width="760" height="720" as="geometry" />
        </mxCell>

        <!-- ACTORS (BÊN TRÁI) -->
        <mxCell id="act_customer" value="Khách hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="40" height="70" as="geometry" />
        </mxCell>

        <mxCell id="act_staff" value="Nhân viên&#xa;(Thu ngân / Phục vụ)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="40" height="70" as="geometry" />
        </mxCell>

        <mxCell id="act_admin" value="Quản lý&#xa;(Admin)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="40" height="70" as="geometry" />
