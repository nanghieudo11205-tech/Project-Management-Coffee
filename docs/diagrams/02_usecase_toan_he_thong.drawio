        <!-- LIÊN KẾT TÁC NHÂN -> USE CASE -->
        <mxCell id="l_c_menu" style="endArrow=none;html=1;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;" edge="1" parent="1" source="act_customer" target="uc_menu"><mxGeometry relative="1" as="geometry" /></mxCell>
